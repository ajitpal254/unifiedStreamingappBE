# PostgreSQL connection string
# Local: postgresql://postgres:<YOUR_PASSWORD>@localhost:5432/streaming_hub
# Hosted (Neon/Supabase): copy the connection string from your dashboard
DATABASE_URL=

# Clerk keys (from clerk.com → your app → API Keys)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# TMDB API — get your Read Access Token at https://www.themoviedb.org/settings/api
# Use the long "API Read Access Token" (JWT), NOT the short API key
TMDB_ACCESS_TOKEN=

# URL of the frontend (for CORS)
FRONTEND_URL=http://localhost:3000

# Server port
PORT=4000
